# ------------------------------------------------------------------
# Google Sheets (used as the database — see lib/db, scripts/setup-sheet)
# Create a service account with the Sheets API enabled, then share the
# spreadsheet with the service account email (Editor access).
# ------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR\nKEY\nHERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz1234567890

# ------------------------------------------------------------------
# imgbb (image uploads — server-side only, key never reaches the client)
# Get a key at https://api.imgbb.com/
# ------------------------------------------------------------------
IMGBB_API_KEY=your-imgbb-api-key

# ------------------------------------------------------------------
# Admin authentication (Phase 4)
# Generate the bcrypt hash:  npx bcryptjs-cli hash "your-password" 10
# Generate SESSION_SECRET:   openssl rand -base64 48
# ------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2a$10$........................................................
SESSION_SECRET=generate-a-long-random-string-here

# ------------------------------------------------------------------
# Public site URL (used for SEO, OG tags, sitemap)
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://omar.dev
