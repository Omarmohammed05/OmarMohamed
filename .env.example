# ------------------------------------------------------------------
# Neon Postgres (the database — see lib/db, scripts/migrate.ts)
# Provision with the Neon CLI:  neon init && neon deploy
# That writes DATABASE_URL / DATABASE_URL_UNPOOLED into .env.local.
# DATABASE_URL (pooled, "-pooler" host) is for app queries;
# DATABASE_URL_UNPOOLED (direct) is for migrations and seeds.
# ------------------------------------------------------------------
DATABASE_URL=postgres://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require

# ------------------------------------------------------------------
# imgbb (image uploads — server-side only, key never reaches the client)
# Get a key at https://api.imgbb.com/
# ------------------------------------------------------------------
IMGBB_API_KEY=your-imgbb-api-key

# ------------------------------------------------------------------
# Admin authentication (Phase 4)
# Generate the bcrypt hash:  npx bcryptjs-cli hash "your-password" 10
# Generate SESSION_SECRET:   openssl rand -base64 48
# ------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2a$10$........................................................
SESSION_SECRET=generate-a-long-random-string-here

# ------------------------------------------------------------------
# Public site URL (used for SEO, OG tags, sitemap)
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://omar.dev
